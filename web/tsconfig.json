{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": ["../../ui/node_modules/@types", "../../ui/node_modules"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["../../ui/src/*"],
      "react": ["../../ui/node_modules/@types/react"],
      "react/*": ["../../ui/node_modules/@types/react/*"],
      "react-dom": ["../../ui/node_modules/@types/react-dom"]
    }
  },
  "include": ["src"]
}
