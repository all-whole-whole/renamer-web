# Keep the working tree byte-identical on every platform: the project is pure
# Node + plain assets, and every text file is stored and checked out as LF.
* text=auto eol=lf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
*.rnp binary
