{
  "name": "renamer-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local-first batch renamer: zero-dependency Node host + React UI served to the system browser",
  "keywords": [
    "renamer",
    "batch-rename",
    "file-renamer",
    "bulk-rename",
    "nodejs",
    "local-first",
    "windows",
    "react"
  ],
  "homepage": "https://github.com/all-whole-whole/renamer-web#readme",
  "bugs": {
    "url": "https://github.com/all-whole-whole/renamer-web/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/all-whole-whole/renamer-web.git"
  },
  "license": "MIT",
  "author": "hertui34",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "renamer-web": "bin/cli.mjs"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "check": "node bin/check.mjs",
    "test": "node test/run.mjs",
    "web:dev": "vite --config web/vite.standalone.config.ts",
    "web:build": "vite build --config web/vite.standalone.config.ts",
    "web:check": "tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
